#Access DNA sequenced data and then compare against RNA VCFs

cd /workspace/lab/houlahanlab/resources/external_datasets/tcga_pancancer_atlas

# Find sample in .fam
grep "TCGA-06-0645" PCA.r1.TCGAbarcode.merge.tnSwapCorrected.10389.fam

# Create keep file
echo "TCGA-06-0645-10A-01D-1492-08 TCGA-06-0645-10A-01D-1492-08" > 0645keep.txt

# Extract EGFR-region SNPs
/workspace/lab/houlahanlab/software/plink-1.9/plink \
  --bfile PCA.r1.TCGAbarcode.merge.tnSwapCorrected.10389 \
  --keep 0645keep.txt \
  --chr 7 \
  --from-bp 55086714 \
  --to-bp 55279321 \
  --recode vcf \
  --out TCGA-06-0645.EGFR.hg19

# Count hg19 variants
grep -vc "^#" TCGA-06-0645.EGFR.hg19.vcf

# Add chr prefix
sed 's/^7\t/chr7\t/' TCGA-06-0645.EGFR.hg19.vcf \
  > TCGA-06-0645.EGFR.hg19.chr.vcf

# Liftover hg19 -> hg38
picard -Xmx4g LiftoverVcf \
  I=/workspace/lab/houlahanlab/resources/external_datasets/tcga_pancancer_atlas/TCGA-06-0645.EGFR.hg19.chr.vcf \
  O=~/projects/hla_pipeline/egfr_liftover/TCGA-06-0645.EGFR.hg38.vcf \
  CHAIN=/workspace/lab/houlahanlab/resources/chain_files/hg19ToHg38.over.chain \
  REJECT=~/projects/hla_pipeline/egfr_liftover/TCGA-06-0645.EGFR.hg38.rejected.vcf \
  R=/workspace/lab/houlahanlab/resources/GRCh38_Indexes/GATK-resource-bundle/Homo_sapiens_assembly38.fasta \
  RECOVER_SWAPPED_REF_ALT=true

# Count successful liftovers
grep -vc "^#" ~/projects/hla_pipeline/egfr_liftover/TCGA-06-0645.EGFR.hg38.vcf

# Count rejected variants
grep -vc "^#" ~/projects/hla_pipeline/egfr_liftover/TCGA-06-0645.EGFR.hg38.rejected.vcf

# Inspect rejected variant(s)
grep -v "^#" ~/projects/hla_pipeline/egfr_liftover/TCGA-06-0645.EGFR.hg38.rejected.vcf

