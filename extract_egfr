#This script takes the DNA files and lifts the coordinates from h19 to h38 so we can compare coordinates

#reminder to run it in bash
#!/bin/bash

#stop running if there is an error, so we don't produce nonsense output
set -e

########################################
# CHANGE ONLY THIS
########################################

SAMPLE="TCGA-06-2569"

########################################
# PATHS
########################################

TCGA_DIR="/workspace/lab/houlahanlab/resources/external_datasets/tcga_pancancer_atlas"

OUTDIR="$HOME/projects/hla_pipeline/opossum_test/tcga_outputs"

PLINK="/workspace/lab/houlahanlab/software/plink-1.9/plink"

CHAIN="/workspace/lab/houlahanlab/resources/chain_files/hg19ToHg38.over.chain"

REF="/workspace/lab/houlahanlab/resources/GRCh38_Indexes/GATK-resource-bundle/Homo_sapiens_assembly38.fasta"

########################################
# START
########################################

mkdir -p "$OUTDIR"

#move into the TCGA directory
cd "$TCGA_DIR"

echo "Finding aliquot for $SAMPLE"

#find the sample within the fam file
ALIQUOT=$(grep "$SAMPLE" PCA.r1.TCGAbarcode.merge.tnSwapCorrected.10389.fam | awk '{print $1}' | head -1)

echo "Found:"
echo "$ALIQUOT"

echo
echo "Creating keep file"

#create a keep txt for just the sample
echo "$ALIQUOT $ALIQUOT" > keep.txt

cat keep.txt

echo
echo "Running PLINK"

#keep only EGFR regions
$PLINK \
    --bfile PCA.r1.TCGAbarcode.merge.tnSwapCorrected.10389 \
    --keep keep.txt \
    --chr 7 \
    --from-bp 55086714 \
    --to-bp 55279321 \
    --recode vcf \
    --out ${OUTDIR}/${SAMPLE}.EGFR.hg19

echo
echo "Number of variants"

#count number of variants
grep -vc "^#" ${OUTDIR}/${SAMPLE}.EGFR.hg19.vcf

echo
echo "Adding chr prefix"

#Picard prefers chromosome names matching the reference so 7 --> chr7

sed 's/##contig=<ID=7,/##contig=<ID=chr7,/' \
    ${OUTDIR}/${SAMPLE}.EGFR.hg19.vcf \
    > ${OUTDIR}/${SAMPLE}.EGFR.hg19.chr.vcf

sed -i 's/^7\t/chr7\t/' \
    ${OUTDIR}/${SAMPLE}.EGFR.hg19.chr.vcf

echo
echo "Checking VCF"

head -15 ${OUTDIR}/${SAMPLE}.EGFR.hg19.chr.vcf

echo
echo "Running Liftover"

export _JAVA_OPTIONS="-Xmx8g"

picard LiftoverVcf \
    I=${OUTDIR}/${SAMPLE}.EGFR.hg19.chr.vcf \
    O=${OUTDIR}/final_hg38/${SAMPLE}.EGFR.hg38.vcf \
    CHAIN=$CHAIN \
    REJECT=${OUTDIR}/${SAMPLE}.EGFR.hg38.rejected.vcf \
    R=$REF \
    RECOVER_SWAPPED_REF_ALT=true

echo
echo "Finished liftover"

ls -lh ${OUTDIR}/${SAMPLE}.EGFR.hg38.vcf

echo
echo "Output files:"

ls -lh ${OUTDIR}/final_hg38/${SAMPLE}.EGFR.*

echo
echo "Done!"
