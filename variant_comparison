# Shared positions
common_pos <- intersect(
  dna_2561$POS,
  rna_2561$POS
)

length(common_pos)

# Keep only shared variants
dna_common <- dna_2561[
  dna_2561$POS %in% common_pos,
]

rna_common <- rna_2561[
  rna_2561$POS %in% common_pos,
]

# REF concordance
sum(
  dna_common$REF ==
    rna_common$REF
)

