sum(
  dna_common$ALT ==
    rna_common$ALT
)



library(vcfR)
library(dplyr)

# Extract genotypes
dna_gt <- extract.gt(vcf_2561_dna, element = "GT")[,1]
rna_gt <- extract.gt(rna_2561_vcf, element = "GT")[,1]

# Build DNA table
dna <- as.data.frame(
  getFIX(vcf_2561_dna),
  stringsAsFactors = FALSE
) |>
  transmute(
    CHROM,
    POS = as.numeric(POS),
    REF,
    ALT,
    GT.DNA = dna_gt
  )

# Build RNA table
rna <- as.data.frame(
  getFIX(rna_2561_vcf),
  stringsAsFactors = FALSE
) |>
  transmute(
    CHROM,
    POS = as.numeric(POS),
    REF,
    ALT,
    QUAL = as.numeric(QUAL),
    GT.RNA = rna_gt
  )

# Keep only shared positions
shared_2561 <- inner_join(
  dna,
  rna,
  by = c("CHROM", "POS"),
  suffix = c(".DNA", ".RNA")
)

# Compare REF and ALT alleles
shared_2561 <- shared_2561 |>
  mutate(
    same_ref = REF.DNA == REF.RNA,
    same_alt = ALT.DNA == ALT.RNA
  )

# Treat 1/0 and 0/1 as the same genotype
norm_gt <- function(gt) {
  sapply(
    strsplit(gt, "[/|]"),
    function(x) paste(sort(x), collapse = "/")
  )
}

# Compare genotypes
shared_2561 <- shared_2561 |>
  mutate(
    GT.DNA.n = ifelse(is.na(GT.DNA), NA, norm_gt(GT.DNA)),
    GT.RNA.n = ifelse(is.na(GT.RNA), NA, norm_gt(GT.RNA)),
    concordant = GT.DNA.n == GT.RNA.n
  )

# View table
shared_2561

# Optional: save to CSV
write.csv(
  shared_2561,
  "TCGA-06-2561_DNA_vs_RNA.csv",
  row.names = FALSE
)
